n\nsurface area estimation in a one Observe the child and score the child’s pain according to the ‘FLACC’ sca"}], "metadata": {"source_id": "sats_0048", "source": "sats", "doc_type": "guideline_section", "style": "protocol_lookup", "section_type": "treatment", "prompt_version": "v1"}}
